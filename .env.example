# --- Database ---
# PostgreSQL connection string. Use a serverless-compatible provider
# (Neon, Supabase, Vercel Postgres, etc.) for Vercel deployments.
DATABASE_URL="postgresql://user:password@localhost:5432/memora?schema=public"

# --- Authentication (NextAuth.js) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- Optional OAuth providers ---
# Only required if you enable Google sign-in in lib/auth/options.ts
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Notion import (single page only, see lib/imports/notion-import.ts) ---
# 1. Create an internal integration at https://www.notion.so/my-integrations
# 2. Copy its "Internal Integration Secret" here.
# 3. In Notion, open each page you want importable → ••• menu → Connections
#    → add the integration. Only pages shared this way can be imported —
#    the integration (and therefore Memora) has no access to anything else
#    in the workspace.
NOTION_API_KEY=""

# --- File upload limits ---
# Max upload size in bytes for note imports (default 10MB)
MAX_UPLOAD_SIZE_BYTES="10485760"
